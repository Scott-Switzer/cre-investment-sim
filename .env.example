# REAL 605 CRE Simulation — environment variables
# Copy to .env and fill in. Never commit real values.

# Optional: Census API key for live ACS retrieval.
# Get one at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional: FRED API key for live macro retrieval.
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Demo control
DEMO_MODE=true

# Random seed for reproducible synthetic data and simulation
SYNTHETIC_SEED=20240331

# Scoring weights (must sum to 1.0). See config/scoring.yaml.
# SCORING_FINANCIAL=0.35
# SCORING_FORECAST=0.25
# SCORING_RISK=0.15
# SCORING_DECISION=0.15
# SCORING_PROCESS=0.10

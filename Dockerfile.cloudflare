FROM node:22-bookworm AS game-builder
WORKDIR /app/services/game
COPY services/game/package.json services/game/package-lock.json ./
RUN npm ci
COPY services/game/ ./
RUN npm run build
RUN npm prune --omit=dev

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=8080 HOST=0.0.0.0
WORKDIR /app
COPY --from=game-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=game-builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY requirements-engine.txt ./
RUN pip install --no-cache-dir -r requirements-engine.txt
COPY --from=game-builder /app/services/game/dist ./services/game/dist
COPY --from=game-builder /app/services/game/node_modules ./services/game/node_modules
COPY --from=game-builder /app/services/game/package.json ./services/game/package.json
COPY services/game/src ./services/game/src
COPY service ./service
COPY src ./src
COPY config ./config
COPY scripts/serve_engine.py ./scripts/serve_engine.py
COPY cloudflare/start.sh ./cloudflare/start.sh
RUN chmod +x ./cloudflare/start.sh
EXPOSE 8080
CMD ["/app/cloudflare/start.sh"]

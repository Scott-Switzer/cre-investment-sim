{
  "name": "cre-investment-committee-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRE Investment Committee — persistent classroom game service. Talks to the private Python engine; the browser never does.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && vite build",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:client": "vitest run --config vite.config.ts --root . client/src",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-cre 'vitest run src/store/firestore.test.ts'"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@google-cloud/firestore": "^7.11.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^3.0.5"
  }
}
